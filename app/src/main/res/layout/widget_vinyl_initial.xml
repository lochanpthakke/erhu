<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_vinyl_widget_bg" android:scaleType="fitXY" android:contentDescription="" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_idle_title" android:textColor="@color/widget_vinyl_text" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_idle_hint" android:textColor="@color/widget_vinyl_secondary" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="11dp" android:src="@drawable/ic_widget_skip_previous" android:tint="@color/widget_vinyl_text" android:contentDescription="@string/widget_cd_previous" />
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="11dp" android:src="@drawable/ic_widget_play" android:tint="@color/widget_vinyl_text" android:contentDescription="@string/widget_cd_play" />
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="11dp" android:src="@drawable/ic_widget_skip_next" android:tint="@color/widget_vinyl_text" android:contentDescription="@string/widget_cd_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
