<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain HTTP is permitted at the platform level only so that a self-hosted music server on the
  user's own network (typically http://192.168.x.x) can be reached. Android cannot scope this to
  an address the user types at run time, so the rule is enforced in the app instead:
  - every built-in online service erhu talks to is addressed over https:// in code;
  - a remote music server is contacted over HTTP only after the user ticks "Allow an unencrypted
    connection" for that one server (RemoteSource.allowInsecure, checked in connectionFor()).
  User-installed certificates are not trusted (the platform default), so HTTPS stays strict.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
