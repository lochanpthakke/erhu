<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base translucent dark glass backdrop -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#330E0F1A" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Specular surface sheen gradient overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#20FFFFFF"
                android:centerColor="#05FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Outer luminous glass rim border highlight -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1.5dp"
                android:color="#4DFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
